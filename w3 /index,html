<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>甜心迷因產生器 | 網頁前端作品集</title>

    <!-- Tailwind CSS (樣式庫) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- FontAwesome (圖示庫) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts (甜美圓潤字型：Fredoka 與 Noto Sans TC) -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">

    <!-- html2canvas (用於將預覽區轉成圖片並下載) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        body {
            font-family: 'Fredoka', 'Noto Sans TC', sans-serif;
            background: linear-gradient(-45deg, #ff9a9e, #fecfef, #a18cd1, #fbc2eb, #fad0c4);
            background-size: 400% 400%;
            animation: gradientMove 12s ease infinite;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* 柔和流動背景動畫 */
        @keyframes gradientMove {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* 毛玻璃面板效果 (Glassmorphism) */
        .glass-panel {
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1.5px solid rgba(255, 255, 255, 0.7);
            box-shadow: 0 12px 32px 0 rgba(235, 160, 195, 0.25);
        }

        /* 背景漂浮微粒 */
        .bg-particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }

        .particle {
            position: absolute;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.1));
            box-shadow: 0 0 12px rgba(255, 182, 193, 0.5);
            animation: floatParticle linear infinite;
        }

        @keyframes floatParticle {
            0% { transform: translateY(105vh) rotate(0deg) scale(0.6); opacity: 0; }
            15% { opacity: 0.8; }
            85% { opacity: 0.8; }
            100% { transform: translateY(-10vh) rotate(360deg) scale(1.2); opacity: 0; }
        }

        /* 迷因文字專用黑邊陰影與厚重粗體 (確保在任何圖片皆清晰) */
        .meme-text {
            font-family: 'Noto Sans TC', sans-serif;
            font-weight: 900;
            text-transform: uppercase;
            color: #ffffff;
            text-shadow: 
                -3px -3px 0 #000,  
                 3px -3px 0 #000,
                -3px  3px 0 #000,
                 3px  3px 0 #000,
                 0px 4px 8px rgba(0, 0, 0, 0.7);
            letter-spacing: 1px;
            word-break: break-all;
            user-select: none;
        }

        /* 自訂美化滑桿 (Range Input) */
        input[type="range"] {
            accent-color: #ec4899;
        }
    </style>
</head>
<body class="relative flex flex-col items-center justify-start min-h-screen py-6 px-4 sm:px-6">

    <!-- 背景動態漂浮微粒 -->
    <div class="bg-particles" id="particlesContainer"></div>

    <!-- 主要內容容器 -->
    <main class="w-full max-w-5xl z-10 space-y-6">

        <!-- 頂部標題區 -->
        <header class="glass-panel rounded-3xl p-6 text-center relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-40 h-40 bg-pink-300/40 rounded-full blur-2xl pointer-events-none"></div>
            <div class="absolute -bottom-12 -left-12 w-40 h-40 bg-purple-300/40 rounded-full blur-2xl pointer-events-none"></div>
            
            <a href="../index.html" class="inline-flex items-center gap-2 text-xs font-bold text-purple-700 bg-white/60 hover:bg-white px-3 py-1.5 rounded-full shadow-sm mb-3 transition-all">
                <i class="fa-solid fa-arrow-left"></i> 返回冒險地圖
            </a>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 tracking-wide flex items-center justify-center gap-2">
                <i class="fa-solid fa-face-laugh-squint text-pink-500"></i> 甜心自定義迷因產生器 <span class="text-pink-500 animate-pulse">✨</span>
            </h1>
            <p class="text-purple-900/80 text-xs sm:text-sm mt-1">上傳圖片、加入金句，打造屬於你的專屬迷因！🌸</p>
        </header>

        <!-- 核心互動區：左右雙欄 (手機自動變上下疊加) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- 左側：控制面板區 (佔 5 欄) -->
            <section class="lg:col-span-5 glass-panel rounded-3xl p-6 space-y-5 flex flex-col justify-between">
                <div class="space-y-4">
                    <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2 border-b border-white/50 pb-2">
                        <i class="fa-solid fa-sliders text-pink-500"></i> 控制面板
                    </h2>

                    <!-- 1. 圖片上傳 (本機檔案讀取，避開 CORS) -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-purple-900">
                            <i class="fa-solid fa-image mr-1"></i> 選擇上傳底圖
                        </label>
                        <input type="file" id="imageInput" accept="image/*" 
                            class="w-full text-xs text-purple-900 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-pink-500 file:text-white hover:file:bg-pink-600 file:cursor-pointer cursor-pointer bg-white/50 rounded-xl p-2 border border-white/80 shadow-inner transition-all">
                    </div>

                    <!-- 2. 上方文字輸入 -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-purple-900">
                            <i class="fa-solid fa-arrow-up mr-1"></i> 上方文字
                        </label>
                        <input type="text" id="topTextInput" placeholder="輸入上方文字..." 
                            class="w-full bg-white/70 border border-white rounded-xl px-3.5 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-pink-400 shadow-inner">
                    </div>

                    <!-- 上方文字位置微調滑桿 -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-[11px] font-semibold text-purple-900">
                            <span>上方文字垂直位置</span>
                            <span id="topPosValue">5%</span>
                        </div>
                        <input type="range" id="topPosRange" min="2" max="45" value="5" class="w-full h-2 bg-pink-100 rounded-lg appearance-none cursor-pointer">
                    </div>

                    <!-- 3. 下方文字輸入 -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-purple-900">
                            <i class="fa-solid fa-arrow-down mr-1"></i> 下方文字
                        </label>
                        <input type="text" id="bottomTextInput" placeholder="輸入下方文字..." 
                            class="w-full bg-white/70 border border-white rounded-xl px-3.5 py-2 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-pink-400 shadow-inner">
                    </div>

                    <!-- 下方文字位置微調滑桿 -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-[11px] font-semibold text-purple-900">
                            <span>下方文字垂直位置</span>
                            <span id="bottomPosValue">85%</span>
                        </div>
                        <input type="range" id="bottomPosRange" min="50" max="92" value="85" class="w-full h-2 bg-pink-100 rounded-lg appearance-none cursor-pointer">
                    </div>

                    <!-- 4. 字體大小控制滑桿 -->
                    <div class="space-y-1 pt-2">
                        <div class="flex justify-between text-[11px] font-semibold text-purple-900">
                            <span>字體大小調整</span>
                            <span id="fontSizeValue">28px</span>
                        </div>
                        <input type="range" id="fontSizeRange" min="16" max="60" value="28" class="w-full h-2 bg-pink-100 rounded-lg appearance-none cursor-pointer">
                    </div>
                </div>

                <!-- 5. 一鍵下載按鈕 -->
                <button id="downloadBtn" 
                    class="w-full bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-600 hover:to-purple-700 text-white font-bold py-3 px-6 rounded-2xl shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2 text-sm cursor-pointer">
                    <i class="fa-solid fa-download"></i> 下載我的迷因圖 🚀
                </button>
            </section>

            <!-- 右側：迷因即時預覽區 (佔 7 欄) -->
            <section class="lg:col-span-7 glass-panel rounded-3xl p-6 flex flex-col items-center justify-center">
                <div class="w-full flex items-center justify-between mb-3 px-2">
                    <h2 class="text-sm font-bold text-gray-800 flex items-center gap-2">
                        <i class="fa-solid fa-eye text-purple-600"></i> 即時預覽畫面
                    </h2>
                    <span class="text-[11px] text-pink-600 font-semibold bg-white/60 px-2.5 py-0.5 rounded-full border border-white">
                        自動合成中 ✨
                    </span>
                </div>

                <!-- 迷因圖片與文字合成容器 (html2canvas 將截取此區塊) -->
                <div id="memeCard" class="relative w-full max-w-md aspect-square bg-white/50 rounded-2xl overflow-hidden shadow-xl border-2 border-white flex items-center justify-center">
                    <!-- 預設提示背景或上傳後的圖片 -->
                    <img id="memeImage" src="https://placehold.co/600x600/ffd1dc/7e22ce?text=📸+請點擊左側上傳圖片" 
                        alt="Meme Preview" class="w-full h-full object-contain bg-neutral-900">

                    <!-- 上方文字圖層 -->
                    <div id="topTextDisplay" class="meme-text absolute left-4 right-4 text-center px-2 pointer-events-none" style="top: 5%;">
                        上方的搞笑金句
                    </div>

                    <!-- 下方文字圖層 -->
                    <div id="bottomTextDisplay" class="meme-text absolute left-4 right-4 text-center px-2 pointer-events-none" style="top: 85%;">
                        下方的吐槽心聲
                    </div>
                </div>
            </section>

        </div>

        <!-- 頁尾 -->
        <footer class="text-center pt-4 pb-2 text-xs text-white/90 font-medium">
            <p>© 2026 Web Development Portfolio ‧ Meme Generator</p>
        </footer>

    </main>

    <!-- JavaScript 互動邏輯 -->
    <script>
        // 1. 背景動態微粒生成
        function initParticles() {
            const container = document.getElementById('particlesContainer');
            for (let i = 0; i < 15; i++) {
                const p = document.createElement('div');
                p.classList.add('particle');
                const size = Math.random() * 30 + 10;
                p.style.width = `${size}px`;
                p.style.height = `${size}px`;
                p.style.left = `${Math.random() * 100}%`;
                p.style.animationDuration = `${Math.random() * 10 + 8}s`;
                p.style.animationDelay = `${Math.random() * 5}s`;
                container.appendChild(p);
            }
        }

        // 2. 取得 DOM 元素
        const imageInput = document.getElementById('imageInput');
        const memeImage = document.getElementById('memeImage');
        const topTextInput = document.getElementById('topTextInput');
        const bottomTextInput = document.getElementById('bottomTextInput');
        const topTextDisplay = document.getElementById('topTextDisplay');
        const bottomTextDisplay = document.getElementById('bottomTextDisplay');
        
        const fontSizeRange = document.getElementById('fontSizeRange');
        const fontSizeValue = document.getElementById('fontSizeValue');
        const topPosRange = document.getElementById('topPosRange');
        const topPosValue = document.getElementById('topPosValue');
        const bottomPosRange = document.getElementById('bottomPosRange');
        const bottomPosValue = document.getElementById('bottomPosValue');
        const downloadBtn = document.getElementById('downloadBtn');
        const memeCard = document.getElementById('memeCard');

        // 3. 處理本機圖片上傳 (使用 FileReader 避免 CORS 跨域錯誤)
        imageInput.addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    memeImage.src = e.target.result;
                    // 上傳後自動切換背景色為白色以適應圖片比例
                    memeImage.classList.remove('bg-neutral-900');
                    memeImage.classList.add('bg-white');
                }
                reader.readAsDataURL(file);
            }
        });

        // 4. 即時同步文字輸入
        topTextInput.addEventListener('input', (e) => {
            topTextDisplay.textContent = e.target.value || '上方的搞笑金句';
        });

        bottomTextInput.addEventListener('input', (e) => {
            bottomTextDisplay.textContent = e.target.value || '下方的吐槽心聲';
        });

        // 5. 滑桿控制字體大小
        fontSizeRange.addEventListener('input', (e) => {
            const size = e.target.value + 'px';
            fontSizeValue.textContent = size;
            topTextDisplay.style.fontSize = size;
            bottomTextDisplay.style.fontSize = size;
        });

        // 6. 滑桿控制上方文字垂直位置
        topPosRange.addEventListener('input', (e) => {
            const pos = e.target.value + '%';
            topPosValue.textContent = pos;
            topTextDisplay.style.top = pos;
        });

        // 7. 滑桿控制下方文字垂直位置
        bottomPosRange.addEventListener('input', (e) => {
            const pos = e.target.value + '%';
            bottomPosValue.textContent = pos;
            bottomTextDisplay.style.top = pos;
        });

        // 8. 一鍵下載圖檔 (透過 html2canvas 將預覽區轉成圖片)
        downloadBtn.addEventListener('click', () => {
            downloadBtn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i> 正在生成圖片...';
            downloadBtn.disabled = true;

            html2canvas(memeCard, {
                useCORS: true, // 允許載入跨域圖片
                scale: 2       // 提高匯出圖片的清晰度
            }).then(canvas => {
                const link = document.createElement('a');
                link.download = 'my-meme.png';
                link.href = canvas.toDataURL('image/png');
                link.click();

                // 恢復按鈕狀態
                downloadBtn.innerHTML = '<i class="fa-solid fa-download"></i> 下載我的迷因圖 🚀';
                downloadBtn.disabled = false;
            }).catch(err => {
                console.error('截圖失敗：', err);
                alert('圖片下載發生錯誤，請稍後再試！');
                downloadBtn.innerHTML = '<i class="fa-solid fa-download"></i> 下載我的迷因圖 🚀';
                downloadBtn.disabled = false;
            });
        });

        // 初始化微粒
        window.addEventListener('DOMContentLoaded', initParticles);
    </script>
</body>
</html>
